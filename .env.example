# Copy this to `.env` and fill in.
# `ops/env-check.js` validates that every key here exists in `.env`.

# --- Domain identity (optional; overrides domain.yaml) ---
# DOMAIN_NAME=
# DOMAIN_OWNER=

# --- External services ---
# Each entry should correspond to an adapter under adapters/<name>/.
# Example:
# POSTGRES_URL=postgresql://localhost:5432/yourdomain
# MUKADRA_ENGINE_URL=http://127.0.0.1:8100
# RUNSNATIVE_SHELL_URL=http://127.0.0.1:3500

# --- Secrets ---
# Read these via .strip() — trailing whitespace from setx/cmd wrappers
# causes silent HTTP header failures on Windows.
# OPENAI_API_KEY=
